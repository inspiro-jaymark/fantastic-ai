{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "serve static app",
            "type": "shell",
            "command": "python3",
            "args": [
                "-m",
                "http.server",
                "8080",
                "--bind",
                "127.0.0.1"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Serving HTTP on.*$",
                    "endsPattern": "^.*Serving HTTP on.*$"
                }
            }
        }
    ]
}
